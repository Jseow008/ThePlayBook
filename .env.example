# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL (used for OG metadata, sitemap, robots.txt)
# Set this to your production domain in Vercel env vars
NEXT_PUBLIC_SITE_URL=https://www.netflux.blog

# PostHog product analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
# Same-origin proxy configured in next.config.ts to remain compatible with CSP.
NEXT_PUBLIC_POSTHOG_HOST=/flux
# Optional: links admin Content Insights to your PostHog project dashboard
# NEXT_PUBLIC_POSTHOG_PROJECT_URL=https://us.posthog.com/project/YOUR_PROJECT_ID

# Service role key for admin operations (server-side only)
SUPABASE_SERVICE_KEY=your-service-key-here

# AI defaults
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001
AI_COMPLEX_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Optional fallback provider for routes that still support OpenAI generation.
OPENAI_API_KEY=your-openai-api-key-here

# Transactional request-board notifications
# Used by /api/admin/request-notifications/process when a requested summary is published.
RESEND_API_KEY=your-resend-api-key-here
REQUEST_NOTIFICATION_FROM_EMAIL="Netflux <notifications@example.com>"
# REQUEST_NOTIFICATION_REPLY_TO_EMAIL=support@example.com

# Background worker auth for cron/external schedulers.
CRON_SECRET=your-cron-secret-here

# Note: Admin authentication now uses Supabase Auth with RBAC.
# After running migrations, create an admin by:
# 1. Sign up a user through the app or Supabase Dashboard
# 2. Run: UPDATE profiles SET role = 'admin' WHERE email = 'your-email@example.com';

# Admin IP Allowlist (optional but recommended for production)
# Comma-separated IPs that may access /admin-login, /admin/*, /api/admin/*
# When unset, the IP gate is disabled (safe for local dev).
# ADMIN_ALLOWED_IPS=203.0.113.42,198.51.100.7
