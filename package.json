{
  "name": "netflux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/proxy.test.ts tests/security/ tests/api/health.test.ts tests/api/activity-log.test.ts tests/api/admin-*.test.ts",
    "test:e2e:responsive": "playwright test tests/e2e/responsive-public.spec.ts tests/e2e/responsive-authenticated.spec.ts tests/e2e/responsive-admin.spec.ts --project=mobile-se --project=mobile-iphone --project=mobile-landscape --project=tablet-portrait --project=tablet-landscape --project=desktop-chromium",
    "test:e2e:responsive:surfaces": "playwright test tests/e2e/responsive-surfaces-*.spec.ts --project=mobile-se --project=mobile-iphone --project=mobile-landscape --project=tablet-portrait --project=tablet-landscape --project=desktop-chromium",
    "analyze": "ANALYZE=true next build --webpack",
    "analyze:ci": "CI=true ANALYZE=true next build --webpack",
    "check:bundle-budgets": "node scripts/check-bundle-budgets.mjs",
    "check:client-boundaries": "node scripts/check-client-boundaries.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:admin-rpc-acls": "node scripts/check-supabase-admin-rpc-acls.mjs",
    "security:function-acls": "node scripts/check-supabase-function-acls.mjs",
    "security:supabase-advisors": "node scripts/check-supabase-security-advisors.mjs",
    "security:analytics-rls": "node scripts/check-supabase-analytics-rls.mjs",
    "security:embedding-table-reads": "node scripts/check-supabase-embedding-table-reads.mjs",
    "security:storage-bucket-listing": "node scripts/check-supabase-storage-bucket-listing.mjs",
    "embeddings:sync-segments": "tsx scripts/sync-segment-embeddings.ts",
    "validate:launch-env": "node scripts/validate-launch-env.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "check:deployment-health": "node scripts/check-deployment-health.mjs",
    "posthog:dashboards": "node scripts/create-posthog-dashboards.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.47",
    "@ai-sdk/openai": "^3.0.30",
    "@ai-sdk/react": "^3.0.99",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.52.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.60.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.62.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "@vercel/analytics": "^2.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.97",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.469.0",
    "next": "^16.2.9",
    "posthog-js": "^1.393.0",
    "posthog-node": "^5.35.11",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.22.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^28.1.0",
    "supabase": "^2.95.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
